source 'https://rubygems.org'

# Match GitHub Pages' Jekyll/Liquid versions without installing unused themes
# and CommonMark extensions (the latter do not support Ruby 4).
gem 'jekyll', '~> 3.10.0'
gem 'liquid', '~> 4.0.4'
gem 'kramdown-parser-gfm', '~> 1.1'
gem 'webrick', '~> 1.8'

group :jekyll_plugins do
  gem 'jekyll-feed', '~> 0.17.0'
  gem 'jekyll-sitemap', '~> 1.4'
  gem 'jekyll-redirect-from', '~> 0.16.0'
end

# Standard-library gems required explicitly with recent Ruby releases.
gem 'csv', '~> 3.3'
gem 'bigdecimal', '~> 3.1'
gem 'logger', '~> 1.6'
gem 'base64', '~> 0.3'
